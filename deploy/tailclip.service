[Unit]
Description=tailclip private clipboard relay
Documentation=https://github.com/EveningStudy/tailclip
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/tailclip/tailclip.py --unix /run/tailclip/tailclip.sock
Environment=PYTHONUNBUFFERED=1
# Limits (defaults shown):
#Environment=TAILCLIP_MAX_ITEMS=20 TAILCLIP_MAX_ITEM_MB=25 TAILCLIP_MAX_TOTAL_MB=150 TAILCLIP_TTL_HOURS=24
# Optionally accept only these Tailscale logins (comma separated):
#Environment=TAILCLIP_ALLOWED_LOGINS=you@github
Restart=on-failure

# The socket lives in a 0700 directory owned by a throwaway user, so only root
# (tailscaled) can connect. Other users and services on the host cannot.
DynamicUser=yes
RuntimeDirectory=tailclip
RuntimeDirectoryMode=0700
UMask=0077

# No network at all: the service only talks over its Unix socket.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX

MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
